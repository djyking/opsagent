[Unit]
Description=OpsAgent daily database and attachment backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
WorkingDirectory=/opt/opsagent/deploy/public
ExecStart=/usr/bin/bash /opt/opsagent/deploy/public/scripts/backup-daily.sh
TimeoutStartSec=15min
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
