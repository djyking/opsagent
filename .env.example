# Copy to .env and replace every development placeholder before starting containers.
OPS_MYSQL_ROOT_PASSWORD=change_me_mysql
OPS_REDIS_PASSWORD=change_me_redis
OPS_RABBITMQ_USERNAME=opsagent
OPS_RABBITMQ_PASSWORD=change_me_rabbitmq
OPS_ES_JAVA_OPTS=-Xms512m -Xmx512m
OPS_QDRANT_URL=http://qdrant:6333
OPS_QDRANT_COLLECTION=ops_knowledge_vector_v1
OPS_QDRANT_ALIAS=ops_knowledge_vector_read
OPS_QDRANT_API_KEY=
OPS_PROMETHEUS_PUBLIC_URL=http://127.0.0.1:9090
OPS_GRAFANA_PUBLIC_URL=http://127.0.0.1:3000

# Applications. Copy this file to .env for Compose; .env is ignored by Git.
OPS_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
OPS_AUTH_DB_PASSWORD=change_me_mysql
OPS_TICKET_DB_PASSWORD=change_me_mysql
OPS_KNOWLEDGE_DB_PASSWORD=change_me_mysql
OPS_RAG_DB_PASSWORD=change_me_mysql
NACOS_ENABLED=false
NACOS_CONFIG_ENABLED=false
NACOS_SERVER_ADDR=localhost:8848
OPS_REDIS_ENABLED=false
OPS_REDIS_HOST=localhost
OPS_REDIS_PORT=6379
OPS_REDIS_PASSWORD=change_me_redis
OPS_REDIS_DATABASE=0
SENTINEL_ENABLED=false
SENTINEL_EAGER=false
SENTINEL_DASHBOARD=localhost:8858
SENTINEL_RULE_DATA_ID=ops-rag-sentinel-flow-rules
OPS_MQ_ENABLED=false
OPS_VECTOR_ENABLED=false
OPS_ES_URL=http://localhost:9200
OPS_ES_KNOWLEDGE_INDEX=ops_knowledge_chunk_v2
OPS_VECTOR_MINIMUM_SCORE=0.72
OPS_AI_ENABLED=false
OPS_AI_PROVIDER=deepseek
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
MOONSHOT_API_KEY=
MOONSHOT_MODEL=kimi-k2.6
OPS_RAG_NEIGHBOR_WINDOW=1
