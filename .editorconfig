root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.java]
indent_style = space
indent_size = 4
continuation_indent_size = 8
max_line_length = 100

[{*.xml,pom.xml}]
indent_style = space
indent_size = 4

[{*.yml,*.yaml,*.json,*.ts,*.vue,*.css}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
